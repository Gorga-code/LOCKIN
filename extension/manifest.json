{
  "manifest_version": 3,
  "name": "LOCKIN Tab Controls",
  "version": "0.1.0",
  "description": "Lock the Chrome tabs you select until your LOCKIN solo session ends.",
  "key": "",
  "permissions": ["tabs", "storage"],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"]
  }
}
