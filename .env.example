# Copy to .env.local and fill in. Never commit .env.local.
# Local values come from `npx supabase status` after `npx supabase start`.

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Show the "Continue with Google" button (requires provider setup, see docs/SETUP.md).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Stable ID of the unpacked extension (derived from the pinned manifest key, see extension/README.md).
NEXT_PUBLIC_EXTENSION_ID=

# --- Server-only (NEVER prefix with NEXT_PUBLIC_, never send to browser/extension) ---
# Used only by the RLS integration tests and dev tooling, not by request handlers.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase CLI (exported in your shell before `supabase start`, not read by Next.js) ---
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
