{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "LOCKIN Desktop",
    "version":  "0.1.0",
    "identifier":  "com.lockin.desktop",
    "build":  {
                  "frontendDist":  "../ui"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "LOCKIN Desktop",
                                    "width":  308,
                                    "height":  66,
                                    "visible":  false,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "shadow":  false,
                                    "alwaysOnTop":  true,
                                    "resizable":  false,
                                    "maximizable":  false,
                                    "skipTaskbar":  true
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027 \u0027wasm-unsafe-eval\u0027; connect-src \u0027self\u0027 ipc: http://ipc.localhost; worker-src \u0027self\u0027; media-src \u0027self\u0027 blob:"
                             }
            },
    "bundle":  {
                   "active":  false,
                   "icon":  [
                                "icons/icon.ico",
                                "icons/icon.png"
                            ]
               },
    "plugins":  {
                    "deep-link":  {
                                      "desktop":  {
                                                      "schemes":  [
                                                                      "lockin-focus"
                                                                  ]
                                                  }
                                  }
                }
}
